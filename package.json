{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "lgtm-chrome-extension",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "all": "pnpm build && pnpm check && pnpm lint:fix && pnpm coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@crxjs/vite-plugin": "3.0.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-zip-pack": "1.2.4",
    "vitest": "5.1.0"
  }
}
